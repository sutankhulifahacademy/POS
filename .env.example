# ============================================================================
# Sutan Khulifah POS — Example environment file
# ----------------------------------------------------------------------------
# Copy this file to .env and REPLACE every value below with real, strong,
# unique values before running `docker compose up`. The placeholder values
# shown here are intentionally invalid and will cause the backend to refuse
# to start if used as-is (config.py rejects known insecure defaults).
# ============================================================================

# PostgreSQL credentials — choose a strong, unique password.
POSTGRES_USER=posuser
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
POSTGRES_DB=sutankhulifah_pos

# JWT signing secret — generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Must be at least 32 characters; 64+ recommended. Do NOT use "changeme",
# "secret", or any value from this example file in production.
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET

# Bootstrap admin/owner account. The backend seeds this account on first
# startup only (it will not overwrite an existing account's password).
# Use a strong, unique password. Do NOT reuse Owner@2026 / Kasir@2026 etc.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost,http://localhost:3000

# Public URL the browser uses to reach the backend API.
REACT_APP_BACKEND_URL=http://localhost:8001

# Midtrans (QRIS) — leave empty to disable QRIS payments.
MIDTRANS_SERVER_KEY=
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com

# Optional: set to "production" for production deployments.
ENVIRONMENT=development
DEBUG=false
